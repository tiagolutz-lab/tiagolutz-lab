# Copy to /etc/sftp2oci/<pair-name>.env, then:
#   systemctl enable --now sftp2oci@<pair-name>
REMOTE=sftp-server1
SRC=/outbound/a
PATTERN=ad_*.xml
BUCKET=bucket-a
INTERVAL=15

# Optional: only transfer files at least this many seconds old (default 0 = immediately).
# Useful for servers where the sender writes straight to the final name.
# MIN_AGE_SECONDS=60
