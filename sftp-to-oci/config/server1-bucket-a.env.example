# Copy to /etc/sftp2oci/<pair-name>.env, then:
#   systemctl enable --now sftp2oci@<pair-name>
REMOTE=sftp-server1
SRC=/outbound/a
PATTERN=ad_*.xml
BUCKET=bucket-a
INTERVAL=15

# Ordering key (optional, default mtime):
#   mtime = SFTP modified time (arrival order only if the sender sets it at write time)
#   name  = file name; use when names carry a zero-padded sequence or ISO timestamp
# ORDER_KEY=name
