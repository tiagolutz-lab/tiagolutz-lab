      </mxGeometry>
    </mxCell>
    <mxCell id="a30" value="202 → success (rows stay PROCESSING, OIC calls back) | 401 → refresh + retry once | other → RETRY / ERROR" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
