    <mxCell id="ph5" value="⑤ Fetch live running instance counts (async, ≤ 5 s)" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="680" width="440" height="20" as="geometry" />
    </mxCell>
    <mxCell id="ph6" value="⑥ Per-interface dispatch loop (ordered by PRIORITY)" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="1000" width="440" height="20" as="geometry" />
    </mxCell>
    <mxCell id="ph7a" value="⑦-A  ATP_INDIVIDUAL → p_dispatch_individual_intf()" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="1120" width="480" height="20" as="geometry" />
