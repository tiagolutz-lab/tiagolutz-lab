    <mxCell id="ph1" value="① Scheduler trigger — fires every 15 seconds" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
