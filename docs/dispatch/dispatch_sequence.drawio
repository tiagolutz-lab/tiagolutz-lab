    <mxCell id="ph9" value="⑨ Message lifecycle &amp; cap rules" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="2150" width="400" height="20" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ①  SCHEDULER → DISPATCH                        -->
    <!-- ═══════════════════════════════════════════════ -->
    <mxCell id="a1" value="DISPATCH()" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1F6FEB;fontColor=#1F6FEB;fontSize=11;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry x="100" y="150" relative="1" as="geometry">
        <mxPoint x="100" y="150" as="sourcePoint" />
        <mxPoint x="310" y="150" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ②  REMOVE_DUPLICATES + SEQUENCE_MSGS           -->
    <!-- ═══════════════════════════════════════════════ -->
    <mxCell id="a2" value="REMOVE_DUPLICATES() → delete duplicate MSG_IDs (keep lowest per business key)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="210" as="sourcePoint" />
        <mxPoint x="550" y="210" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a3" value="duplicates removed" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="550" y="240" as="sourcePoint" />
        <mxPoint x="310" y="240" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a4" value="SEQUENCE_MSGS() → promote QUEUED / RETRY → READY_TO_DISPATCH" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="290" as="sourcePoint" />
        <mxPoint x="550" y="290" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a5" value="STATUS updated + COMMIT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="550" y="320" as="sourcePoint" />
        <mxPoint x="310" y="320" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ③  DISCOVER INTERFACES                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <mxCell id="a6" value="SELECT DISTINCT interface_id, stage_number, dispatch_type, priority, max_msgs WHERE STATUS=READY_TO_DISPATCH AND m.STATUS=A AND m.OUTAGE=N" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="420" as="sourcePoint" />
        <mxPoint x="550" y="420" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a7" value="l_intfs[] ordered by PRIORITY, INTERFACE_ID, STAGE_NUMBER" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="550" y="450" as="sourcePoint" />
        <mxPoint x="310" y="450" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <!-- Note: IF exit -->
    <mxCell id="n1" value="IF l_intf_count = 0 → EXIT (nothing to dispatch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#30363D;fontColor=#E3B341;fontSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="340" y="470" width="360" height="30" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ④  LOAD ENVIRONMENTS                           -->
    <!-- ═══════════════════════════════════════════════ -->
    <mxCell id="a8" value="SELECT env_id, base_url, MAX_MSGS FROM AD_OIC_ENVIRONMENTS WHERE STATUS=A" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="620" as="sourcePoint" />
        <mxPoint x="790" y="620" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a9" value="l_envs[] + run_id = YYYYMMDDHH24MISSFF3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="790" y="650" as="sourcePoint" />
        <mxPoint x="310" y="650" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ⑤  RUNNING COUNTS                              -->
    <!-- ═══════════════════════════════════════════════ -->
    <mxCell id="a10" value="UPDATE LAST_RUNNING_COUNT = NULL (clear stale values)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="710" as="sourcePoint" />
        <mxPoint x="790" y="710" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a11" value="SPAWN 'AD_GET_INST_{run_id}_{i}' per env (auto_drop=TRUE, enabled=TRUE)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="750" as="sourcePoint" />
        <mxPoint x="1030" y="750" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a12" value="HTTP GET OIC /monitoring/… → UPDATE LAST_RUNNING_COUNT = N" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E3B341;fontColor=#E3B341;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1030" y="790" as="sourcePoint" />
        <mxPoint x="790" y="790" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <!-- Poll note -->
    <mxCell id="n2" value="POLL every 0.5 s × 10 (5 s max)&#xa;EXIT when all envs have a count&#xa;NULL after timeout → running_count = −1 (static allocation fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#30363D;fontColor=#B1BAC4;fontSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="340" y="820" width="540" height="60" as="geometry" />
    </mxCell>
    <mxCell id="a13" value="READ LAST_RUNNING_COUNT; SET available_cap = NVL(MAX_MSGS, 2147483647)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="900" as="sourcePoint" />
        <mxPoint x="790" y="900" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a14" value="f_get_bearer_token(env_id) — OAuth Bearer (cached or force_fresh)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="940" as="sourcePoint" />
        <mxPoint x="790" y="940" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a15" value="bearer_token per env" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="790" y="970" as="sourcePoint" />
        <mxPoint x="310" y="970" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ⑥  PER-INTERFACE LOOP                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <mxCell id="n3" value="FOR each interface in l_intfs[] (ordered by PRIORITY, INTERFACE_ID, STAGE_NUMBER)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#30363D;fontColor=#B1BAC4;fontSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="200" y="1030" width="600" height="30" as="geometry" />
    </mxCell>
    <mxCell id="a16" value="f_validate_allocation() → check AD_INT_ENV_ALLOCATION sums to 100 %" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="1080" as="sourcePoint" />
        <mxPoint x="550" y="1080" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a17" value="TRUE → continue / FALSE → SKIP interface" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="550" y="1100" as="sourcePoint" />
        <mxPoint x="310" y="1100" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ⑦-A  p_dispatch_individual_intf                -->
    <!-- ═══════════════════════════════════════════════ -->
    <mxCell id="a18" value="p_dispatch_individual_intf(envs, env_count, interface_id, stage_number, intf_cap, run_id)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#58A6FF;fontColor=#58A6FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="310" y="1150" as="sourcePoint" />
        <mxPoint x="1270" y="1150" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a19" value="BULK COLLECT LIMIT 1000 — READY_TO_DISPATCH msgs (loop until EOF)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#79C0FF;fontColor=#79C0FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1270" y="1190" as="sourcePoint" />
        <mxPoint x="550" y="1190" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a20" value="l_all_msg_ids[] total = N messages" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="550" y="1220" as="sourcePoint" />
        <mxPoint x="1270" y="1220" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <!-- chunk_size note -->
    <mxCell id="n4" value="chunk_size = GREATEST(50, NVL(INDIVIDUAL_BATCH_SIZE, 50))&#xa;→ minimum 50 msgs per DB job AND per OIC HTTP call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#30363D;fontColor=#B1BAC4;fontSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="900" y="1240" width="500" height="45" as="geometry" />
    </mxCell>
    <mxCell id="a21" value="f_compute_interface_quotas(total_msgs, intf_cap) [STATIC or DYNAMIC]" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#79C0FF;fontColor=#79C0FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1270" y="1305" as="sourcePoint" />
        <mxPoint x="790" y="1305" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a22" value="l_quotas[i] per env (in msgs); available_cap deducted" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6E7681;fontColor=#6E7681;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="790" y="1335" as="sourcePoint" />
        <mxPoint x="1270" y="1335" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <!-- CHUNK_ID note -->
    <mxCell id="n5" value="Assign CHUNK_ID per msg (round-robin across envs by quota)&#xa;chunk_id = &quot;{run_id}_{global_worker}_{env_id}&quot;&#xa;global_worker++ when MOD(assigned_to_env, chunk_size) = 0&#xa;No env capacity → chunk_id = NULL (held over to next run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#21262D;strokeColor=#30363D;fontColor=#B1BAC4;fontSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="900" y="1355" width="500" height="70" as="geometry" />
    </mxCell>
    <mxCell id="a23" value="FORALL UPDATE AD_MSG_AUDIT SET STATUS=PROCESSING, CHUNK_ID → COMMIT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#79C0FF;fontColor=#79C0FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1270" y="1440" as="sourcePoint" />
        <mxPoint x="550" y="1440" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="a24" value="p_submit_job('AD_DISP_IND_{run_id}_{seq}', chunk_id, 'DISPATCH_INDIVIDUAL_CHUNK') × unique chunks" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#79C0FF;fontColor=#79C0FF;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
