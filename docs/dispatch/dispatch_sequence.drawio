      <mxGeometry x="40" y="180" width="400" height="20" as="geometry" />
    </mxCell>
    <mxCell id="ph3" value="③ Discover interfaces with pending messages" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
