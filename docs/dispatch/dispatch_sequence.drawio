    <mxCell id="a29" value="HTTP POST JSON array BLOB | Authorization: Bearer {token}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#FFA657;fontColor=#FFA657;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
