    <mxCell id="ph8a" value="⑧-A  DISPATCH_INDIVIDUAL_CHUNK(chunk_id) — scheduler job" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="1490" width="520" height="20" as="geometry" />
    </mxCell>
    <mxCell id="ph7b" value="⑦-B  ATP_GROUP → p_dispatch_group_intf()" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8B949E;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
