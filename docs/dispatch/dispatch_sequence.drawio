    <mxCell id="a28" value="Build JSON array [MsgId, MsgObjectId, InterfaceId, BusinessId1..5] via DBMS_LOB.APPEND → CONVERTTOBLOB (avoids ORA-06502)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#FFA657;fontColor=#FFA657;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1">
